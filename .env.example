# ==============================================================================
# Veridex Environment Configuration (.env.example)
# Copy this file to .env and replace placeholder values with your actual credentials.
# ==============================================================================

# --- Application Settings ---
APP_NAME=Veridex-RAG
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# --- AWS Credentials & Region ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# --- AWS S3 (Document Source of Truth) ---
S3_BUCKET_NAME=veridex-documents-storage

# --- AWS DynamoDB (Chat Memory) ---
DYNAMODB_TABLE_NAME=veridex-chat-history

# --- AWS Bedrock ---
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# Alternative free/lightweight options:
# meta.llama3-8b-instruct-v1:0
# amazon.nova-lite-v1:0

# --- Free Tier Fallback LLM (Groq) ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL_NAME=llama-3.1-8b-instant

# --- Vector Database (Pinecone) ---
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=veridex-rag-index
PINECONE_ENVIRONMENT=us-east-1

# --- Embedding Model (HuggingFace Local) ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- AWS Cognito (Auth & RBAC) ---
COGNITO_USER_POOL_ID=your_cognito_user_pool_id
COGNITO_APP_CLIENT_ID=your_cognito_app_client_id

# --- Observability (Langfuse / Optional) ---
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

